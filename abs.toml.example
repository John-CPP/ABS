config_version = 1

# ABS example config. Copy to ~/.config/abs/abs.toml or /etc/abs/abs.toml,
# or create/edit it with:
#   abs --config-wizard
#   abs --configure
#   abs --configure=nano
# (tested editors: vim, nano, kate)

# Self-Updates (Root-level configurations)
check_for_update_on_startup = true
auto_update_on_startup = false
self_update_at_updates = false
self_update_use_pacman = true
install_absgui = true
# UI language: en, de, es, ar, ru, zh, ja. First setup uses the system language when it is one of these.
# lang = "en"
# self_update_install_path = "/usr/bin/abs"  # used when self_update_use_pacman = false (absgui installed beside it)
# If false, checks for newer versions of Arch Linux or CachyOS packages using stable pacman sync databases instead of git.
# install_testing_phase_archlinux_packages = false

manual_update_packages = [
]
# Packages excluded from system update (repo binaries), via pacman/yay --ignore.
# Glob patterns are supported: "qemu*" matches all repo/installed names starting with qemu.
skip_install_packages = [
]
# Packages excluded from pacman -U after manual compilation (omit to inherit skip_install_packages).
skip_install_packages_after_compilation = [
]

# Packages pinned to a fixed pkgver-pkgrel. Held names are ignored during system update and are
# not version-compared on -R/-RU. Rebuild manually with `abs <pkg>` (applies the held version),
# or via on_packages_updated triggers when those packages change outside ABS (checked on -U).
# Example:
# [[held_packages]]
# name = "libfoo"
# version = "1.2.3-1"
#
# [held_packages.auto_recompile_trigger.on_packages_updated]
# glibc = "2.41-1"
# icu = "76.1-1"
#
# Manage without editing this file:
#   abs --list-add=manual_update_packages pkg
#   abs --list-remove=skip_install_packages pkg
#   abs --hold pkg --hold-version=1.2.3-1 --trigger=glibc,icu
#   abs --unhold pkg
#   abs --hold-check
#   abs --wizard[=add|remove|edit|hold]

[paths]
# Git clones / sources. Optional to share across machines; the folder that skips
# compiles is ready_made_packages_path (see README "Several computers").
packages_path = "$XDG_CACHE_HOME/abs/packages"
chroot_base_path = "$XDG_CACHE_HOME/abs/chroot"
# Finished .pkg.tar.* files (PKGDEST). Share this directory so other PCs reuse
# compiles, including abs --self-update packages. Do not use pacman's CacheDir here.
ready_made_packages_path = "$XDG_CACHE_HOME/abs/ready"
# Optional: path to a custom makepkg.conf file to inject into the chroot container
# chroot_makepkg_conf = "~/.config/abs/makepkg.conf"

# Optional tmpfs/ramdisk: speeds up builds and reduces disk wear.
# Disk [paths] remain the persistent locations; ramdisk holds ephemeral compile state.
# Set enabled = true, then turn on individual targets (build_workdir, chroot, packages).
[ramdisk]
# Enable tmpfs/ramdisk support (requires sudo when a package task opts in via global or per-package
# targets). Tmpfs is mounted lazily on the first build/download that needs it, not at ABS startup.
enabled = false
# Absolute path where tmpfs is mounted for this ABS run (must not be a system root like / or /run).
mount_point = "/run/abs-ram"
# Maximum tmpfs size passed to mount -o size= (cap, not pre-allocated). Increase for large builds or parallel chroot workers.
size = "16G"
# Directory permissions for the tmpfs mount root (octal, e.g. 0755).
mode = "0755"
# During each build, symlink src/ and pkg/ under the package directory to per-package dirs on tmpfs (compile I/O in RAM).
# Also redirects ccache / TMPDIR / Cargo / Go / npm / pip caches onto `$mount_point/cache` so they do not write to the SSD.
# Default for all packages when no per-package override is set. Use per-package `ramdisk = "wcp"` to override.
build_workdir = false
# Use tmpfs for chroot_base_path during makechrootpkg (-h) builds instead of the disk path in [paths].
chroot = false
# Use tmpfs for the entire packages_path (git clones and sources). High RAM use; off by default.
packages = false
# Optional disk directory to rsync into the ram chroot before first use (copies the entire tree; leave unset for a fresh mkarchroot on RAM).
# seed_chroot_from = ""
# On normal ABS exit, rsync the ram chroot back to seed_chroot_from when sync_chroot_on_exit = true (requires seed_chroot_from).
sync_chroot_on_exit = false
# Refuse to mount tmpfs when MemAvailable in /proc/meminfo is below this value (MiB).
min_free_ram_mb = 4096
# Temporary ABS-owned compressed swap (independent of the RAM disk).
# full (default): max remaining RAM as the compressed-RAM cap, disksize 4× that.
# off: do not bring up ABS zram. Used for compiles and system update, not only PGO convert.
zram = "full"
# Print a warning when packages = true because full-repo-on-RAM can consume many gigabytes.
warn_packages_ram = true
# Unmount mount_point before mounting when it is already mounted (cleans up after a crashed ABS run).
reclaim_mount_on_startup = true

[build]
default_environment = "local"
ignore_compilation_failures = false
compile_first_install_after = false
clean_install_by_default = false
# When false (default), skip compilation if matching .pkg.tar.* already exist in
# ready_made_packages_path and install those instead (unless -o). Use -n or set true to force rebuild.
# Keep false on machines that should reuse packages compiled on another PC.
ignore_already_made_packages = false
concurrent_repos_downloads_limit = 10
# Maximum number of clean chroot compilations to run concurrently
concurrent_compilations_limit = 1
# Check AUR package versions using the AUR RPC API in batch
fast_aur_rpc_update_checks = true
# Perform system update before compiling packages (highly recommended to prevent broken shared libraries)
system_update_first = true
# After each chroot (makechrootpkg) build, remove working copies and reset the devtools chroot when idle
clean_chroot_after_compilation = true
# CPU-aware scheduler: strict = hard cap on sum of active threads; flexible = soft cap + optional burst
global_cpu_threads_mode = "strict"
# global_cpu_threads_cap = 10
# maximum_cpu_threads_cap = 15   # flexible mode only
# default_compilation_threads = 5

[system_update]
command_to_update_repositories = "sudo pacman -Sy"
command_to_perform_system_update = "sudo pacman -Syu"
command_to_perform_system_update_no_refresh = "sudo pacman -Su"
# Minutes between automatic pending-update fetches in AbsGui. 0 = only the Refresh button
# (first visit still loads the list). Integer or string is accepted.
auto_refresh_delay = 0
# true: type sudo once; AbsGui keeps it in a private runtime file until you quit.
# false: ask on every privileged command (same as before).
remember_sudo = false
ignore_flag = "--ignore"
ignore_packages = []

[repositories]
arch = "https://gitlab.archlinux.org/archlinux/packaging/packages"
aur = "https://aur.archlinux.org"
cachyos = "https://github.com/CachyOS/CachyOS-PKGBUILDS.git"
default = "arch"

[packages]

# Example: build an AUR package (or use `abs --repo=aur xray` without config entry).
# Optional: on `-RU`, check GitHub for newer (including pre-)releases and bump PKGBUILD before build.
# [packages.xray]
# source = "aur"
# upstream_github = "xtls/xray-core"
# upstream_prereleases = true
# build_env = "local"
# tests = true
# Override [build].ignore_already_made_packages for this package (true = always rebuild).
# ignore_already_made_packages = true
# pre_update_command = "rm -rf mozbuild"
# post_update_command = ""
# Per-package ramdisk targets when [ramdisk].enabled = true (replaces global build_workdir/chroot/packages for this package):
# w = build workdir (src/, pkg/), c = chroot, p = packages (git clone on tmpfs). Example: ramdisk = "wcp"
# ramdisk = "disabled"  # force disk-only for this package (same as ramdisk = "")
# ramdisk = "wcp"
# Or on the CLI (quote in zsh): abs 'mesa[ramdisk=wcp]'  /  abs 'electron40[ramdisk=disabled]'
# Or without brackets: abs --ramdisk=wcp mesa  /  abs --ramdisk=disabled electron40

# Example: CachyOS kernel 3-stage PGO (AutoFDO + Propeller)
# [packages.linux-cachyos]
# source = "aur"
# build_env = "local"
# compilation_threads = 8
# compile_alone = true
# compilation_priority = 10
# ramdisk = "w"
#
# [packages.linux-cachyos.kernel]
# _cpusched = "cachyos"
# _processor_opt = "native"
#
# [packages.linux-cachyos.pgo]
# enabled = true
# profiles_archive_dir = "/mnt/data/abs/pgo/profiles"
# save_kernels_dir = "/mnt/data/abs/pgo/kernels"  # optional; copies each stage to {dir}/{YYYY-MM-DD}/{debug|autofdo|final}/
# propeller_profiles_on_ram = true  # skip HDD archive; final Propeller build is same boot
# convert_relocate = "force"  # force | smart — move tmpfs capture to disk before convert (avoids OOM)
# benchmark_command = "/path/to/custom-benchmark.sh"  # optional; default is bundled assets/pgo-benchmark.sh
#
# Training workload. perf samples kernel branches only (`:k`), so this decides which
# kernel code AutoFDO and Propeller can see. Functions with no samples are treated as
# cold: they lose inlining and move to .text.unlikely. Training is always the kernel
# path suite (syscall, scheduler, VFS, network). Leftover fast/cachyos values are ignored.
# kernel_workload_seconds = 0  # 0 = from profiling_quality (short 10 min, sweet 20 min, long 60 min)
#
# Duration profile. Training (under perf) and kbench comparison (no perf):
#   short  ~10 min train,  ~3 min kbench
#   sweet  ~20 min train,  ~6 min kbench   (default)
#   long   ~60 min train, ~10 min kbench
# profiling_quality = "sweet"  # short | sweet | long  (aliases: standard→sweet, maximum→long)
# Does not shorten CachyOS-benchmarker (always the full suite).
#
# Scoring (no perf). kbench (default via auto), cachyos, or kbench+cachyos.
# compare_preset = "kbench"  # kbench | auto | cachyos | kbench+cachyos
# cachyos needs cachyos-benchmarker on PATH (~30–60 min; first run downloads).
# propeller_tool = "auto"  # generate_propeller_profiles (built if needed for LLVM 22+) or create_llvm_prof
# perf_extra_args = "--mmap-pages 4096 -a -N -b -c 400009"  # override auto quality; mmap-pages is per CPU
# build_user = "builder"
# sysctl_command = "cachyos-perf-sysctl"
# auto_restart = false  # reboot + resume in a visible terminal until PGO completes (--pgo-auto)
# select_boot_kernel = true  # oneshot next boot to this stage's kernel (bootctl / grub-reboot); does not change the default
# reboot_before_start = false  # reboot into the current kernel before the first comparison (same cold-boot as later stages)
# shutdown_after_finish = false  # power off the PC after the pipeline completes (not on abort)
# reuse_afdo_profile = false  # skip AutoFDO collection when a suitable archived profile exists
# reuse_propeller_profile = false  # skip Propeller collection when suitable archived profiles exist
# skip_propeller = false  # stop after AutoFDO (no Propeller collect/compile); that kernel is production
# Comparison charts: {profiles_archive_dir}/compare-benchmarks.
# Checkboxes are no-perf scored runs (workload = compare_preset). Profiling (with perf)
# still feeds with-overhead charts whenever any comparison is on. Every scored clean run
# drops page cache (echo 3) and CPU-warms first.
# compare_current = false   # kernel already booted, before the debug PGO build
# compare_debug_clean = false  # debug kernel, no perf
# compare_autofdo_clean = false  # AutoFDO kernel, no perf
# compare_final = false     # last kernel after the last reboot (Propeller, or AutoFDO if skip_propeller)
# compare_debug / compare_autofdo remain valid in old configs (with-overhead is automatic now)
